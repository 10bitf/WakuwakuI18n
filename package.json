{
  "name": "wakuwaku-i18n",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Wakuwaku 项目共用的文案/多语言框架",
  "exports": {
    "./load": {
      "types": "./src/load.d.ts",
      "default": "./src/load.js"
    },
    "./i18next-preset": {
      "types": "./src/i18next-preset.d.ts",
      "default": "./src/i18next-preset.js"
    },
    "./exempt": {
      "default": "./src/exempt.js"
    },
    "./scan": {
      "types": "./src/scan.d.ts",
      "default": "./src/scan.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test"
  }
}
