{
  "name": "wakuwaku-i18n",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Wakuwaku 项目共用的文案/多语言框架",
  "exports": {
    "./load": {
      "types": "./src/load.d.ts",
      "default": "./src/load.js"
    },
    "./i18next-preset": {
      "types": "./src/i18next-preset.d.ts",
      "default": "./src/i18next-preset.js"
    },
    "./exempt": {
      "default": "./src/exempt.js"
    },
    "./scan": {
      "types": "./src/scan.d.ts",
      "default": "./src/scan.js"
    },
    "./compile": "./src/compile.js",
    "./make-t": "./src/make-t.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@messageformat/core": "^3.4.0",
    "@messageformat/runtime": "^3.0.2"
  },
  "peerDependenciesMeta": {
    "@messageformat/core": {
      "optional": true
    },
    "@messageformat/runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@messageformat/core": "^3.4.0",
    "@messageformat/runtime": "^3.0.2"
  }
}
